{
    "template_version": "1.1",
    "description": "Strict Binary Loan Evaluation Output (Approve/Deny Only)",
    "output_schema": {
        "agent_name": "<string: name of the agent>",
        "loan_type": "personal_loan",
        "approval_decision": "<string: approve | deny>",
        "approval_type": "<string: STANDARD_TERMS | DENIAL>",
        "interest_rate": "<float: 2.0-30.0>",
        "confidence_probability": "<int: 0-100>",
        "confidence_level": "<string: low | medium | high>",
        "approval_decision_reason": "<string: why approve or deny>",
        "approval_type_reason": "<string: why this classification>",
        "interest_rate_reason": "<string: how rate was determined>",
        "confidence_reason": "<string: why this confidence level>"
    },
    "validation_rules": {
        "approval_decision": ["approve", "deny"],
        "approval_type": [
            "STANDARD_TERMS",
            "DENIAL"
        ],
        "interest_rate_range": [2.0, 30.0],
        "confidence_probability_range": [0, 100],
        "confidence_level": ["low", "medium", "high"]
    },
    "approval_type_definitions": {
        "STANDARD_TERMS": "Applicant approved for the loan at market rates based on credit score.",
        "DENIAL": "Credit not extended (risk too high, does not meet minimum criteria, not creditworthy)"
    },
    "confidence_guidance": {
        "instruction": "Use the FULL range of confidence scores (0-100%). Do NOT cluster around 50%.",
        "high_confidence": "80-100% when decision is clear and well-supported",
        "medium_confidence": "40-60% ONLY when genuinely uncertain",
        "low_confidence": "0-20% when significant concerns exist"
    }
}